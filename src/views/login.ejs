<%- include('./partials/header') %>

<section class="trains-hero">
    <h1>Learn about our Trains</h1>
    <p>
        Explore the physical trains that power scenic the trips across the Kizuna Rail network.
    </p>
</section>
<!-- test -->
<section class="trains-catalog">
    <div class="trains-state" id="trains-loading">Login</div>

    <form id="login-form" action="/login" method="POST">
        <div class="form-group">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>
        </div>
        <div class="form-group">
            <label for="password">Password:</label>
            <input type="password" id="password" name="password" required>
        </div>
        <button type="submit">Login</button>
    </form>
    
</section>

<%- include('./partials/footer') %>
