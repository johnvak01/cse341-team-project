<%- include('../partials/header') %>

<h1><%- title %></h1>

<div id="admin-controls-bar">
    <a href="/dashboard" class="view-details-btn">&larr; Back to Admin Dashboard</a>
</div>

<div id="filters">
    Search by Region:
    <select id="region-filter">
        <option value="all">All Regions</option>
        <% regions.forEach((region) => { %>
            <option value="<%= region %>"><%= region.charAt(0).toUpperCase() + region.slice(1) %></option>
        <% }); %>
    </select>

    Search by Season:
    <select id="season-filter">
        <option value="all">Any Season</option>
        <% seasons.forEach((season) => { %>
            <option value="<%= season %>"><%= season.charAt(0).toUpperCase() + season.slice(1) %></option>
        <% }); %>
    </select>
</div>

<!-- Modal Overlay & Popup Editor (Uses clean IDs for target styling) -->
<div id="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999;"></div>

<div id="edit-modal" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 500px; max-height: 80vh; overflow-y: auto;box-sizing: border-box; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); z-index: 1000; color: #333;">
    <h3 style="margin-top: 0; padding-bottom: 10px; border-bottom: 1px solid #ddd;">Edit Trip Details</h3>
    
    <form id="admin-edit-form">
        <input type="hidden" id="edit-trip-id">
        
        <p><label>Trip Name:<br><input type="text" id="edit-name" required style="width:100%; padding:6px; box-sizing:border-box;"></label></p>
        <p><label>Description:<br><textarea id="edit-description" required rows="3" style="width:100%; padding:6px; box-sizing:border-box; font-family:sans-serif;"></textarea></label></p>
        <p><label>Distance (km):<br><input type="number" id="edit-distance" min="0" required style="width:100%; padding:6px; box-sizing:border-box;"></label></p>

        <p><label>Start Station:<br>
            <select id="edit-start" required style="width:100%; padding:6px; box-sizing:border-box;">
            <option value="">-- Select Start Station --</option>
            <!-- JavaScript will dynamically inject database station names here -->
        </select>
        </label></p>

        <p><label>End Station:<br>
            <select id="edit-end" required style="width:100%; padding:6px; box-sizing:border-box;">
            <option value="">-- Select End Station --</option>
            <!-- JavaScript will dynamically inject database station names here -->
            </select>
        </label></p>

        <p><label>Associated Schedule IDs (comma separated):<br>
            <select id="edit-schedules" multiple style="width:100%; height: 100px; padding:6px; box-sizing:border-box;"></select>
        <!-- Existing database options will be dynamically injected here -->
            
            <small style="color: #7f8c8d; display: block; margin-top: 4px;">Hold Ctrl (Windows) / Cmd (Mac) to select multiple options.</small>
        </label></p>
        
        <div style="text-align: right; margin-top: 20px;">
            <button type="button" onclick="closeModal()" style="padding: 6px 12px; margin-right: 10px; cursor: pointer;">Cancel</button>
            <button type="submit" style="padding: 6px 12px; background: #27ae60; color: white; border: none; cursor: pointer;">Save Changes</button>
        </div>
    </form>

</div>

<!-- Reuses your exact public container classes -->
<div id="trips-list" class="routes-grid">
    <p>Loading administration data...</p>
</div>

<!-- Reuses your exact public card template setup structure -->
<template id="trip-card-template">
    <div class="route-card">
        <div class="route-header">
            <h2 class="route-name"></h2>
            <span class="route-region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name start-station"></div>
            </div>
            <div class="route-arrow">→</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name end-station"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">🕑</span>
                <span><span class="detail-label">Duration:</span> <span class="trip-duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">📍</span>
                <span><span class="detail-label">Distance:</span> <span class="trip-distance"></span>km</span>
            </div>
            <div class="detail-item">
                <span class="season-badge"></span>
            </div>
        </div>

        <div class="route-description"></div>

        <div class="highlights">
            <div class="highlights-list">
                <!-- Highlight tags will be dynamically injected here -->
            </div>
        </div>
            
        <!-- Modified to stack Admin action buttons instead of a public booking button -->
        <div class="route-actions" style="display: flex; gap: 10px; border-top: 1px solid #eee; padding-top: 10px; margin-top: auto;">
            <button type="button" class="edit-action-btn view-details-btn" style="background: #2980b9; text-align: center; border: none; cursor: pointer; color: white;">✏️ Edit</button>
            <button type="button" class="delete-action-btn view-details-btn" style="background: #c0392b; text-align: center; border: none; cursor: pointer; color: white;">🗑️ Delete</button>
        </div>
    </div>
</template>

<script>
    const openEditForm = async (trip) => {
        document.getElementById('edit-trip-id').value = trip.id;
        document.getElementById('edit-name').value = trip.name;
        document.getElementById('edit-description').value = trip.description;
        document.getElementById('edit-distance').value = trip.distance;
        
        //assign station select property
        document.getElementById('edit-start').value = trip.startStation;
        document.getElementById('edit-end').value = trip.endStation;
        
        //get linked schedule dynamically
        let scheduleSelect = document.getElementById('edit-schedules');

        if(!scheduleSelect){
            const templateDoc = document.getElementById('trip-card-template');
            if(templateDoc){
                scheduleSelect = templateDoc.content.querySelector('#edit-schedules');
            }
        }
        
        //clear out any previous schedule and let add a new schedule from list of schedules
        if(scheduleSelect && scheduleSelect.option){
            Array.from(scheduleSelect.option).forEach(opt => opt.selected = false);
        
        
            try{
                const response = await fetch('/api/schedules');

                if(response.ok){
                    const schedules = await response.json();

                    Array.from(scheduleSelect.ooptions).forEach(option => {
                        const fullScheduleData = schedules.find(s => s.id === option.value);
                        if(fullScheduleData && fullScheduleData.tripId === trip.id){
                            option.selected = true;
                        }
                    })
                }

            }catch(err){
                console.error('Error auto-selecting active schedules:', err);
            }
        }
        
        document.getElementById('modal-overlay').style.display = 'block';
        document.getElementById('edit-modal').style.display = 'block';
    };

    const closeModal = () => {
        document.getElementById('modal-overlay').style.display = 'none';
        document.getElementById('edit-modal').style.display = 'none';
    };

    document.getElementById('admin-edit-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const tripId = document.getElementById('edit-trip-id').value;
        
        const updatePayload = {
            name: document.getElementById('edit-name').value,
            description: document.getElementById('edit-description').value,
            distance: Number(document.getElementById('edit-distance').value),
            startStation: document.getElementById('edit-start').value,
            endStation: document.getElementById('edit-end').value
        };

        const schedInput = document.getElementById('edit-schedules').value.trim();
        if (schedInput) {
            updatePayload.scheduleIds = schedInput.split(',').map(s => s.trim());
        }

        try {
            const response = await fetch(`/api/trips/${tripId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(updatePayload)
            });

            if (!response.ok) {
                const err = await response.json();
                throw new Error(err.error || 'Failed to update trip configuration.');
            }

            closeModal();
            alert('Trip updated successfully!');
            await loadTrips(); 
            applyFilters();
        } catch (error) {
            alert(`Error updating data: ${error.message}`);
        }
    });

    const handleDeleteClick = async (tripId, name) => {
        if (!confirm(`Permanently wipe out "${name}"? This cascades into the Schedule system.`)) return;

        try {
            const response = await fetch(`/api/trips/${tripId}`, { method: 'DELETE' });
            if (!response.ok) throw new Error('Deletion failed at server core.');

            alert('Trip dropped successfully!');
            await loadTrips(); 
            applyFilters();
        } catch (error) {
            alert(error.message);
        }
    };

    //loads stations in the backgrouns for the trips

    const loadStationDropdowns = async () => {
    const startSelect = document.getElementById('edit-start');
    const endSelect = document.getElementById('edit-end');

    try {
        const response = await fetch('/api/stations');
        if (!response.ok) throw new Error('Failed to fetch stations catalog.');
        
        const stations = await response.json();

        stations.forEach(station => {
            // Create selection option for Start
            const optStart = document.createElement('option');
            optStart.value = station.name; 
            optStart.textContent = station.name;
            startSelect.appendChild(optStart);

            // Create selection option for End
            const optEnd = document.createElement('option');
            optEnd.value = station.name;
            optEnd.textContent = station.name;
            endSelect.appendChild(optEnd);
        });
    } catch (error) {
        console.error('Error hydrating station dropdown elements:', error);
    }
};

//loads the schedule in the background

    const loadScheduleDropdown = async () => {
    const scheduleSelect = document.getElementById('edit-schedules');

    try {
        const response = await fetch('/api/schedules'); // Reuses your existing schedules API endpoint
        if (!response.ok) throw new Error('Failed to fetch schedules.');
        
        const schedules = await response.json();

        schedules.forEach(schedule => {
            const option = document.createElement('option');
            option.value = schedule.id; // Sets value to your custom schedule code string/identifier
            
            // Customize text layout depending on your schema properties (e.g. schedule.time or schedule.name)
            option.textContent = `Schedule: ${schedule.id} (${schedule.departureTime || ''})`;
            scheduleSelect.appendChild(option);
        });
    } catch (error) {
        console.error('Error hydrating schedule dropdown option items:', error);
    }
};

//loads trips

    const loadTrips = async () => {

        const tripsCard = document.getElementById('trips-list');
        const templateTrip = document.getElementById('trip-card-template');

        try {
            const response = await fetch('/api/trips');
            if(!response.ok) throw new Error('Failed to retrieve Trips');

            const trips = await response.json();
            tripsCard.innerHTML = "";

            if(trips.length === 0){
                tripsCard.innerHTML = `<p>No trips found.</p>`;
                return;
            }

            trips.forEach(trip => {
                const clone = templateTrip.content.cloneNode(true);
                const cardWrapper = clone.querySelector('.route-card');
                if(trip.region) cardWrapper.classList.add(trip.region);

                clone.querySelector('.route-name').textContent = trip.name;
                clone.querySelector('.route-region').textContent = trip.region;
                clone.querySelector('.start-station').textContent = trip.startStation;
                clone.querySelector('.end-station').textContent = trip.endStation;
                clone.querySelector('.trip-duration').textContent = trip.duration;
                clone.querySelector('.trip-distance').textContent = trip.distance;
                clone.querySelector('.route-description').textContent = trip.description;

                const seasonBadge = clone.querySelector('.season-badge');
                seasonBadge.textContent = `Best in ${trip.bestSeason}`;
                seasonBadge.classList.add(`season-${trip.bestSeason}`);

                const highlightsList = clone.querySelector('.highlights-list');
                if (trip.highlights && Array.isArray(trip.highlights)) {
                    trip.highlights.forEach(highlight => {
                        const tag = document.createElement('span');
                        tag.className = 'highlight-tag';
                        tag.textContent = highlight;
                        highlightsList.appendChild(tag);
                    });
                }

                clone.querySelector('.edit-action-btn').addEventListener('click',() => openEditForm(trip));
                clone.querySelector('.delete-action-btn').addEventListener('click', () => handleDeleteClick(trip.id, trip.name));

                tripsCard.appendChild(clone);
            });
        }catch(error){
            console.error('Error running trip hydration process:', error);
            tripsCard.innerHTML = `<p class="error">Failed to render administrative dataset.</p>`

        }
    }

    let applyFilters = () => {};

    window.addEventListener('DOMContentLoaded', async () =>{

        const regionFilter = document.getElementById('region-filter');
        const seasonFilter = document.getElementById('season-filter');

        applyFilters = () => {

            const selectedRegion = regionFilter.value.toLowerCase();
            const selectedSeason = seasonFilter.value.toLowerCase();
            const cards = document.querySelectorAll('#trips-list .route-card');
            const tripsList = document.getElementById('trips-list');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardRegion = card.querySelector('.route-region').textContent.trim().toLocaleLowerCase();
                const badgeText = card.querySelector('.season-badge').textContent.toLocaleLowerCase();

                const matchesRegion = (selectedRegion==='all' || cardRegion===selectedRegion);
                const matchesSeason = (selectedSeason==='all' || badgeText.includes(selectedSeason));

                if(matchesRegion && matchesSeason){
                    card.style.removeProperty('display');
                    visibleCount +=1;
                }else{
                    card.style.display = 'none';
                }
            });

            let emptyState = document.getElementById('trips-empty');
            if(visibleCount===0){
                if(!emptyState){
                    emptyState = document.createElement('p');
                    emptyState.id = 'trips-empty';
                    emptyState.className = 'trips-empty';
                    tripsList.appendChild(emptyState);
                }

                emptyState.textContent = 'No trips match the selected filters';
            }else if(emptyState){
                emptyState.remove();
            }
        };

        await loadStationDropdowns();
        await loadScheduleDropdown();

        await loadTrips();
        applyFilters();

        regionFilter.addEventListener('change', applyFilters);
        seasonFilter.addEventListener('change', applyFilters);
    });

</script>

<%- include('../partials/footer') %>
